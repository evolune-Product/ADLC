# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sdlc_user:sdlc_pass@localhost:5432/agentic_sdlc
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173
# Where this API is reachable from outside. The OIDC single-sign-on redirect URI
# is built from it, and that URI is what a customer registers with their
# identity provider — so it has to be the real public address in production.
API_BASE_URL=http://localhost:8000

# Deployment mode: saas | self_hosted. Surfaced on /compliance/posture.
DEPLOYMENT_MODE=saas

# ── Auth & encryption ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRY_HOURS=24
# Exactly 32 chars — encrypts OAuth tokens and BYO LLM keys at rest.
ENCRYPTION_KEY=12345678901234567890123456789012

# ── Model providers ───────────────────────────────────────────────────────────
# Platform key. Orgs can override this per workspace with their own key
# (Billing → bring your own model provider), which moves LLM spend off our bill.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Default model for new agents.
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# Embeddings for codebase memory. Without a key the platform falls back to a
# deterministic local embedder — retrieval still works, just less precisely.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Repo & ticket integrations ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Linear and GitLab self-managed instances authenticate with a personal access
# token entered when creating the connection — no app registration needed here.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Billing (optional — the platform runs fully without any gateway) ──────────
# With no gateway configured, plan changes apply directly so self-hosted
# installs work. Enable any subset of the three — a deployment can run
# Stripe-only, Razorpay-only, all three, or none.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Razorpay — the India rail (UPI/netbanking/cards domestically at 2%+GST,
# bank transfer internationally at 1%+GST with no forex markup). Plan ids
# must exist in the Razorpay dashboard first, same precondition as Stripe's
# price ids above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_TEAM=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_ENTERPRISE=

# PayPal — sandbox by default; set PAYPAL_MODE=live only when ready to take
# real charges. PAYPAL_WEBHOOK_ID comes from the webhook you register in the
# PayPal developer dashboard, not from your app credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
PAYPAL_PLAN_TEAM=
PAYPAL_PLAN_GROWTH=
PAYPAL_PLAN_ENTERPRISE=

# ── Notifications (optional) ──────────────────────────────────────────────────
# Without SMTP, approval alerts still land in the in-app bell and Slack.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agentic SDLC <noreply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── Storage ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-sdlc-skills
MINIO_PUBLIC_URL=http://localhost:9000

# ── Execution sandbox (QA agent) ──────────────────────────────────────────────
# Runs each run's own install/test/lint commands in an isolated Docker
# container instead of only asking an LLM to review the diff blind. See
# app/services/sandbox_service.py. Requires the `worker` container to have
# /var/run/docker.sock mounted (already wired in docker-compose.yml) — set to
# false to disable entirely and fall back to the old LLM-only QA review.
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_INSTALL_TIMEOUT_SECONDS=300
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2.0
# REQUIRED when running via docker-compose: the absolute path ./sandbox_data
# resolves to on the actual Docker HOST (e.g. /opt/agentic-sdlc/sandbox_data
# on the VPS) — not a path inside any container. Leave blank for native
# (non-Docker) local dev, where this container boundary doesn't exist. Get
# this wrong and sandbox runs silently mount an empty directory instead of the
# real checkout — see sandbox_service.py's docstring, point 4.
SANDBOX_HOST_PATH=

# ── Compliance ────────────────────────────────────────────────────────────────
# Audit rows older than this are pruned nightly by the Celery beat job.
AUDIT_RETENTION_DAYS=365
# 0 = keep run history forever.
RUN_RETENTION_DAYS=0
# Self-hosted licence key (validated offline; blank for SaaS).
LICENSE_KEY=
