# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sdlc_user:sdlc_pass@localhost:5432/agentic_sdlc
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173

# Deployment mode: saas | self_hosted. Surfaced on /compliance/posture.
DEPLOYMENT_MODE=saas

# ── Auth & encryption ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRY_HOURS=24
# Exactly 32 chars — encrypts OAuth tokens and BYO LLM keys at rest.
ENCRYPTION_KEY=12345678901234567890123456789012

# ── Model providers ───────────────────────────────────────────────────────────
# Platform key. Orgs can override this per workspace with their own key
# (Billing → bring your own model provider), which moves LLM spend off our bill.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Default model for new agents.
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# Embeddings for codebase memory. Without a key the platform falls back to a
# deterministic local embedder — retrieval still works, just less precisely.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ── Repo & ticket integrations ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=

JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=

# Linear and GitLab self-managed instances authenticate with a personal access
# token entered when creating the connection — no app registration needed here.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Billing (optional — the platform runs fully without Stripe) ───────────────
# With no key set, plan changes apply directly so self-hosted installs work.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# ── Notifications (optional) ──────────────────────────────────────────────────
# Without SMTP, approval alerts still land in the in-app bell and Slack.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Agentic SDLC <noreply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ── Storage ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentic-sdlc-skills
MINIO_PUBLIC_URL=http://localhost:9000

# ── Compliance ────────────────────────────────────────────────────────────────
# Audit rows older than this are pruned nightly by the Celery beat job.
AUDIT_RETENTION_DAYS=365
# 0 = keep run history forever.
RUN_RETENTION_DAYS=0
# Self-hosted licence key (validated offline; blank for SaaS).
LICENSE_KEY=
